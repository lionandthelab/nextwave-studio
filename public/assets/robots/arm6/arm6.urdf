<?xml version="1.0"?>
<!--
  arm6.urdf — robot-sim-web 기본 6-DOF 로봇팔 + 평행 그리퍼
  프리미티브 지오메트리만 사용 (외부 메시 파일 불필요 — 정적 호스팅 친화).
  URDF 표준 관례상 Z-up이며, 로딩 시 scene-loader가 Y-up으로 축 변환한다 (CLAUDE.md §4).
  단위: 미터, 라디안.
-->
<robot name="arm6">

  <material name="body_dark">
    <color rgba="0.24 0.26 0.30 1.0"/>
  </material>
  <material name="accent_orange">
    <color rgba="0.90 0.49 0.13 1.0"/>
  </material>
  <material name="joint_black">
    <color rgba="0.14 0.15 0.17 1.0"/>
  </material>
  <material name="finger_gray">
    <color rgba="0.55 0.57 0.62 1.0"/>
  </material>

  <!-- ── 베이스 ─────────────────────────────────────────── -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.025" rpy="0 0 0"/>
      <geometry><cylinder radius="0.06" length="0.05"/></geometry>
      <material name="joint_black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.025" rpy="0 0 0"/>
      <geometry><cylinder radius="0.06" length="0.05"/></geometry>
    </collision>
    <inertial>
      <mass value="1.5"/>
      <inertia ixx="0.01" iyy="0.01" izz="0.01" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <!-- ── J1: 베이스 회전 (yaw) ──────────────────────────── -->
  <joint name="joint1" type="revolute">
    <parent link="base_link"/>
    <child link="link1"/>
    <origin xyz="0 0 0.05" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.1416" upper="3.1416" effort="50" velocity="3.0"/>
  </joint>
  <link name="link1">
    <visual>
      <origin xyz="0 0 0.04" rpy="0 0 0"/>
      <geometry><cylinder radius="0.05" length="0.08"/></geometry>
      <material name="body_dark"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.04" rpy="0 0 0"/>
      <geometry><cylinder radius="0.05" length="0.08"/></geometry>
    </collision>
    <inertial>
      <mass value="1.0"/>
      <inertia ixx="0.005" iyy="0.005" izz="0.005" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <!-- ── J2: 어깨 피치 ─────────────────────────────────── -->
  <joint name="joint2" type="revolute">
    <parent link="link1"/>
    <child link="link2"/>
    <origin xyz="0 0 0.08" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.0" upper="2.0" effort="50" velocity="3.0"/>
  </joint>
  <link name="link2">
    <visual>
      <origin xyz="0 0 0.14" rpy="0 0 0"/>
      <geometry><box size="0.06 0.06 0.28"/></geometry>
      <material name="accent_orange"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.14" rpy="0 0 0"/>
      <geometry><box size="0.06 0.06 0.28"/></geometry>
    </collision>
    <inertial>
      <mass value="0.8"/>
      <inertia ixx="0.005" iyy="0.005" izz="0.002" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <!-- ── J3: 팔꿈치 ────────────────────────────────────── -->
  <joint name="joint3" type="revolute">
    <parent link="link2"/>
    <child link="link3"/>
    <origin xyz="0 0 0.28" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.6" upper="2.6" effort="40" velocity="3.0"/>
  </joint>
  <link name="link3">
    <visual>
      <origin xyz="0 0 0.11" rpy="0 0 0"/>
      <geometry><box size="0.05 0.05 0.22"/></geometry>
      <material name="body_dark"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.11" rpy="0 0 0"/>
      <geometry><box size="0.05 0.05 0.22"/></geometry>
    </collision>
    <inertial>
      <mass value="0.6"/>
      <inertia ixx="0.003" iyy="0.003" izz="0.001" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <!-- ── J4: 손목 롤 ───────────────────────────────────── -->
  <joint name="joint4" type="revolute">
    <parent link="link3"/>
    <child link="link4"/>
    <origin xyz="0 0 0.22" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.1416" upper="3.1416" effort="20" velocity="4.0"/>
  </joint>
  <link name="link4">
    <visual>
      <origin xyz="0 0 0.03" rpy="0 0 0"/>
      <geometry><cylinder radius="0.04" length="0.06"/></geometry>
      <material name="joint_black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.03" rpy="0 0 0"/>
      <geometry><cylinder radius="0.04" length="0.06"/></geometry>
    </collision>
    <inertial>
      <mass value="0.4"/>
      <inertia ixx="0.001" iyy="0.001" izz="0.001" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <!-- ── J5: 손목 피치 ─────────────────────────────────── -->
  <joint name="joint5" type="revolute">
    <parent link="link4"/>
    <child link="link5"/>
    <origin xyz="0 0 0.06" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.9" upper="1.9" effort="20" velocity="4.0"/>
  </joint>
  <link name="link5">
    <visual>
      <origin xyz="0 0 0.03" rpy="0 0 0"/>
      <geometry><box size="0.05 0.05 0.06"/></geometry>
      <material name="accent_orange"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.03" rpy="0 0 0"/>
      <geometry><box size="0.05 0.05 0.06"/></geometry>
    </collision>
    <inertial>
      <mass value="0.3"/>
      <inertia ixx="0.001" iyy="0.001" izz="0.001" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <!-- ── J6: 손목 롤 2 (플랜지) ────────────────────────── -->
  <joint name="joint6" type="revolute">
    <parent link="link5"/>
    <child link="link6"/>
    <origin xyz="0 0 0.06" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.1416" upper="3.1416" effort="10" velocity="5.0"/>
  </joint>
  <link name="link6">
    <visual>
      <origin xyz="0 0 0.015" rpy="0 0 0"/>
      <geometry><box size="0.09 0.05 0.03"/></geometry>
      <material name="joint_black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.015" rpy="0 0 0"/>
      <geometry><box size="0.09 0.05 0.03"/></geometry>
    </collision>
    <inertial>
      <mass value="0.2"/>
      <inertia ixx="0.0005" iyy="0.0005" izz="0.0005" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <!-- ── 그리퍼: 평행 프리즘 조인트 2개 ─────────────────
       값 0.0 = 닫힘, 0.03 = 완전 열림 (양쪽 대칭 구동은 제어 계층 몫) -->
  <joint name="finger_left_joint" type="prismatic">
    <parent link="link6"/>
    <child link="finger_left"/>
    <origin xyz="0.008 0 0.03" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="0.0" upper="0.03" effort="10" velocity="0.1"/>
  </joint>
  <link name="finger_left">
    <visual>
      <origin xyz="0 0 0.03" rpy="0 0 0"/>
      <geometry><box size="0.012 0.03 0.06"/></geometry>
      <material name="finger_gray"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.03" rpy="0 0 0"/>
      <geometry><box size="0.012 0.03 0.06"/></geometry>
    </collision>
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="0.0001" iyy="0.0001" izz="0.0001" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <joint name="finger_right_joint" type="prismatic">
    <parent link="link6"/>
    <child link="finger_right"/>
    <origin xyz="-0.008 0 0.03" rpy="0 0 0"/>
    <axis xyz="-1 0 0"/>
    <limit lower="0.0" upper="0.03" effort="10" velocity="0.1"/>
  </joint>
  <link name="finger_right">
    <visual>
      <origin xyz="0 0 0.03" rpy="0 0 0"/>
      <geometry><box size="0.012 0.03 0.06"/></geometry>
      <material name="finger_gray"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.03" rpy="0 0 0"/>
      <geometry><box size="0.012 0.03 0.06"/></geometry>
    </collision>
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="0.0001" iyy="0.0001" izz="0.0001" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

</robot>
