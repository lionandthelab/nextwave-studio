{
  "name": "robot-sim-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Browser-native simplified IsaacSim-like robot simulator (Rapier + three.js + urdf-loader)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run typecheck && npm run lint && npm run test",
    "gate:build": "vite build",
    "gate:orchestration": "node scripts/gate-browser.mjs --expect=orchestration",
    "gate:planner": "node scripts/gate-browser.mjs --expect=planner",
    "gate:flow-graph": "node scripts/gate-browser.mjs --expect=flow-graph",
    "gate:arm-sequence": "node scripts/gate-browser.mjs --expect=arm-sequence",
    "gate:scene-builder": "node scripts/gate-browser.mjs --expect=scene-builder",
    "gate:scene-switch": "node scripts/gate-browser.mjs --expect=scene-switch",
    "gate": "npm run gate:build && npm run gate:orchestration && npm run gate:planner && npm run gate:flow-graph && npm run gate:arm-sequence && npm run gate:scene-builder && npm run gate:scene-switch",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:dev": "docker compose --profile dev up --build dev",
    "docker:verify": "docker compose --profile ci run --rm verify",
    "docker:check": "node scripts/verify-container.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.113.0",
    "@dimforge/rapier3d-compat": "^0.14.0",
    "three": "^0.169.0",
    "urdf-loader": "^0.12.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/three": "^0.169.0",
    "eslint": "^9.12.0",
    "jsdom": "^25.0.1",
    "playwright": "^1.61.1",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.8.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=18"
  },
  "//": "버전은 Phase 0에서 `npm install` 후 최신으로 검증/갱신할 것. 물리 API 사용 전 `await RAPIER.init()` 필수."
}
