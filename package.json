{
  "name": "robot-sim-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Browser-native simplified IsaacSim-like robot simulator (Rapier + three.js + urdf-loader)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "typecheck:server": "tsc --noEmit -p tsconfig.server.json",
    "lint": "eslint . --ext .ts,.tsx",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run typecheck && npm run typecheck:server && npm run lint && npm run test",
    "server:dev": "tsx watch server/index.ts",
    "server:start": "tsx server/index.ts",
    "gate:build": "vite build",
    "gate:orchestration": "node scripts/gate-browser.mjs --expect=orchestration",
    "gate:planner": "node scripts/gate-browser.mjs --expect=planner",
    "gate:flow-graph": "node scripts/gate-browser.mjs --expect=flow-graph",
    "gate:arm-sequence": "node scripts/gate-browser.mjs --expect=arm-sequence",
    "gate:scene-builder": "node scripts/gate-browser.mjs --expect=scene-builder",
    "gate:scene-switch": "node scripts/gate-browser.mjs --expect=scene-switch",
    "gate:viewport-edit": "node scripts/gate-browser.mjs --expect=viewport-edit",
    "gate:falling-boxes": "node scripts/gate-browser.mjs --expect=falling-boxes",
    "gate:pick-and-place": "node scripts/gate-browser.mjs --expect=pick-and-place",
    "gate:obstacle-avoidance": "node scripts/gate-browser.mjs --expect=obstacle-avoidance",
    "gate:collision-testbed": "node scripts/gate-browser.mjs --expect=collision-testbed",
    "gate:two-arms": "node scripts/gate-browser.mjs --expect=two-arms",
    "gate:conveyor-pick-place": "node scripts/gate-browser.mjs --expect=conveyor-pick-place",
    "//gate:samples": "제공 예제 8종 전부 — 씬 로드 + 시퀀스 완주 + 의도한 충돌/감지",
    "gate:samples": "npm run gate:falling-boxes && npm run gate:arm-sequence && npm run gate:pick-and-place && npm run gate:obstacle-avoidance && npm run gate:collision-testbed && npm run gate:two-arms && npm run gate:conveyor-pick-place && npm run gate:l-line-cell",
    "gate": "npm run gate:build && npm run gate:orchestration && npm run gate:planner && npm run gate:flow-graph && npm run gate:scene-builder && npm run gate:mesh-import && npm run gate:robot-library && npm run gate:scene-switch && npm run gate:viewport-edit && npm run gate:samples",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:dev": "docker compose --profile dev up --build dev",
    "docker:verify": "docker compose --profile ci run --rm verify",
    "docker:check": "node scripts/verify-container.mjs",
    "gate:mesh-import": "node scripts/gate-browser.mjs --expect=mesh-import",
    "gate:robot-library": "node scripts/gate-browser.mjs --expect=robot-library",
    "gate:l-line-cell": "node scripts/gate-browser.mjs --expect=l-line-cell"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.113.0",
    "@dimforge/rapier3d-compat": "^0.14.0",
    "@fastify/static": "^10.1.3",
    "better-sqlite3": "^13.0.3",
    "fastify": "^5.11.2",
    "three": "^0.169.0",
    "urdf-loader": "^0.12.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.1.2",
    "@types/three": "^0.169.0",
    "eslint": "^9.12.0",
    "jsdom": "^25.0.1",
    "playwright": "^1.61.1",
    "tsx": "^4.23.10",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.8.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=18"
  },
  "//": "버전은 Phase 0에서 `npm install` 후 최신으로 검증/갱신할 것. 물리 API 사용 전 `await RAPIER.init()` 필수."
}
