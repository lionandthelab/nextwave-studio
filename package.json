{
  "name": "robot-sim-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Browser-native simplified IsaacSim-like robot simulator (Rapier + three.js + urdf-loader)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run typecheck && npm run lint && npm run test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.113.0",
    "@dimforge/rapier3d-compat": "^0.14.0",
    "three": "^0.169.0",
    "urdf-loader": "^0.12.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/three": "^0.169.0",
    "eslint": "^9.12.0",
    "playwright": "^1.61.1",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.8.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=18"
  },
  "//": "버전은 Phase 0에서 `npm install` 후 최신으로 검증/갱신할 것. 물리 API 사용 전 `await RAPIER.init()` 필수."
}
